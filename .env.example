ANTHROPIC_API_KEY=

# Intake and outline backend: "api" (default, uses ANTHROPIC_API_KEY) or
# "subscription" (uses the Claude Agent SDK billed to your Claude Pro/Max
# subscription via `claude setup-token` / CLAUDE_CODE_OAUTH_TOKEN).
# GENERATION_BACKEND=api
# CLAUDE_CODE_OAUTH_TOKEN=
# PLANNING_MODEL=claude-sonnet-5

# Full lesson generation defaults to GPT-5.6 Sol through the locally
# authenticated Codex CLI. Set both values when changing providers.
# LESSON_GENERATION_BACKEND=codex
# GENERATION_MODEL=gpt-5.6-sol
# CODEX_TIMEOUT_MS=300000
# LESSON_GENERATION_STALE_MS=900000

# Lesson review backend: "api" (default) or "codex". The codex backend requires
# a local authenticated Codex CLI, is intended for development only, and is
# billed to the local ChatGPT subscription rather than the Anthropic API.
# REVIEW_BACKEND=api
# REVIEW_MODEL=claude-sonnet-5
# When REVIEW_BACKEND=codex, the automatic default is:
# REVIEW_MODEL=gpt-5.6-sol
