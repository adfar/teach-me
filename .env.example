ANTHROPIC_API_KEY=

# Generation backend: "api" (default, uses ANTHROPIC_API_KEY) or "subscription"
# (uses the Claude Agent SDK billed to your Claude Pro/Max subscription via
# `claude setup-token` / CLAUDE_CODE_OAUTH_TOKEN, for local/dev use).
# GENERATION_BACKEND=api
# CLAUDE_CODE_OAUTH_TOKEN=
# GENERATION_MODEL=claude-opus-5
# LESSON_GENERATION_STALE_MS=900000

# Lesson review backend: "api" (default) or "codex". The codex backend requires
# a local authenticated Codex CLI, is intended for development only, and is
# billed to the local ChatGPT subscription rather than the Anthropic API.
# REVIEW_BACKEND=api
# REVIEW_MODEL=claude-sonnet-5
# When REVIEW_BACKEND=codex, the automatic default is:
# REVIEW_MODEL=gpt-5.6-sol
